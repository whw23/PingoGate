# =============================================================================
# PingoGate 环境变量模板
# 复制为 .env 并填入真实值。永不提交 .env（已在 .gitignore）。
# 所有密钥经 env:VAR_NAME 引用，运行时解析为 SecretString，Drop 清零（宪法 XX）。
# =============================================================================

# ---- 上游 Provider Key（单机模式 + 平台模式都用）----
# 单机模式：pingogate-core.yaml 里 key_ref: env:VAR_NAME 引用
# 平台模式：Go 控制面录入 BYOK key 时，用户经 API 提交（不经 .env）

OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 第二个 OpenAI-compatible 平台（自建 / Azure OpenAI / 第三方代理）
MY_PROXY_API_KEY=sk-my-proxy-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- 网关 Key（客户端 -> PingoGate 鉴权，单机模式）----
# 客户端持此 key 调网关；pingogate-core.yaml 里 secret_ref: env:VAR_NAME 引用
# 可配多个（YAML gateway_keys 数组），每个是独立可识别主体（principal）
PINGO_KEY_ALPHA=pg-local-dev-key-alpha
PINGO_KEY_BETA=pg-local-dev-key-beta

# ---- Admin API 鉴权（单机模式）----
# healthz / metrics 不需要；reload / config-validate / reload-status 需要
# 缺失 = authed 端点全部 401（不降级为无鉴权）
PINGO_ADMIN_TOKEN=pg-admin-dev-token-change-me

# =============================================================================
# 平台模式（PINGO_MODE=platform 时启用，需同时启动 pingogate-ctrl Go 二进制）
# 单机模式忽略以下所有变量。
# =============================================================================

# 切换到平台模式（默认 standalone）
# PINGO_MODE=platform

# ---- KeyVault 主密钥（平台模式必需，缺失 = 启动失败）----
# 32 字节 AES-GCM 主密钥，用于加密/解密 BYOK provider key
# 生成方法：openssl rand -hex 16（32 字符 hex = 32 字节 ASCII = 208 bits 熵）
# 或：python3 -c "import secrets; print(secrets.token_urlsafe(24)[:32])"
PINGO_MKEK=0123456789abcdef0123456789abcdef

# ---- gRPC 内部通信安全（平台模式必需）----
# Rust 与 Go 之间的 gRPC 共享内部 token（mTLS 之外第二道防线）
# mTLS 证书由 Go 的 grpcmtls 包首次启动时自动生成（自签 CA + 双向证书）
PINGO_INTERNAL_TOKEN=pg-internal-shared-token-change-me

# Rust gRPC server 监听地址（Go 推快照 / 调 KeyVault 加解密 的目标）
# 默认 127.0.0.1:9091（仅 loopback，宪法 §12A）
# PINGO_GRPC_ADDR=127.0.0.1:9091

# mTLS 证书路径（Go grpcmtls 生成的自签 CA + Rust/Go 各证书）
# 默认指向 ctrl-go/internal/grpcmtls/certs/（Go 首次启动时生成）
# PINGO_GRPC_CERT=ctrl-go/internal/grpcmtls/certs/core.pem
# PINGO_GRPC_KEY=ctrl-go/internal/grpcmtls/certs/core.key
# PINGO_GRPC_CA=ctrl-go/internal/grpcmtls/certs/ca.pem
# PINGO_GRPC_CERTS_DIR=internal/grpcmtls/certs

# ---- Go 控制面 bootstrap（平台模式必需）----
# 首次启动 Go 时创建第一个 admin（之后可撤销此 env）
PINGO_BOOTSTRAP_ADMIN_TOKEN=pg-bootstrap-admin-change-me

# Go SQLite 数据库路径（默认 pingogate.db）
# PINGO_DB_DSN=pingogate.db

# Go UsageService gRPC server 地址（Rust 推 usage 事件的目标）
# 默认 127.0.0.1:9092
# PINGO_USAGE_GRPC_ADDR=127.0.0.1:9092

# ---- 平台模式 Pingora 数据面 listener（平台模式）----
# 默认同单机模式
# PINGO_PUBLIC_ADDR=0.0.0.0:8080
# PINGO_ADMIN_ADDR=127.0.0.1:9090
