# Copy to `.env` and fill in real values. Never commit `.env`.
# Referenced from pingogate.yaml as `env:VAR_NAME`; resolved at snapshot build
# and kept protected in memory — never logged in plaintext (constitution XX).

# Upstream provider keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...

# Named gateway key(s) clients present to PingoGate
PINGO_KEY_ALPHA=pg-local-dev-key

# Bootstrap admin credential for the Admin API
PINGO_ADMIN_TOKEN=pg-admin-dev-token

# Platform mode (pingogate-core + pingogate-ctrl gRPC). Set PINGO_MODE=platform
# on the Rust binary to start the gRPC server instead of the standalone Pingora
# data plane. The Go binary (pingogate-ctrl) always uses these vars to dial.
# PINGO_MODE=platform
# PINGO_INTERNAL_TOKEN=pg-internal-shared-token
# PINGO_GRPC_ADDR=127.0.0.1:9091
# PINGO_GRPC_CERT=ctrl-go/internal/grpcmtls/certs/core.pem
# PINGO_GRPC_KEY=ctrl-go/internal/grpcmtls/certs/core.key
# PINGO_GRPC_CA=ctrl-go/internal/grpcmtls/certs/ca.pem
# PINGO_GRPC_CERTS_DIR=internal/grpcmtls/certs
