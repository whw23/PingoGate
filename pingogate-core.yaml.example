# pingogate-core.yaml.example
# PingoGate 内核单机模式配置示例。
#
# 使用方法：
#   1. 复制为 pingogate-core.yaml
#   2. 设置 .env 中的环境变量（或用 plain: 内联明文，见下方示例）
#   3. 启动：./pingogate-core（或 cargo run -p pingogate-core）
#   4. 客户端改 base_url 指向网关，token 用网关 key，model 用别名
#
# 热重载：
#   修改本文件后，SIGHUP / 文件监视 / POST /reload 任一触发原子切换
#   进行中请求继续用旧快照，零中断（宪法 XII）
#
# 平台模式不用此文件（Go 控制面经 gRPC 推送配置）。
# 但可用 go run ./cmd/import-yaml --yaml pingogate-core.yaml 导入到 Go DB。

listeners:
  public: { address: "0.0.0.0:8080" }
  admin:  { address: "127.0.0.1:9090" }

# ---- 网关 Key（客户端 -> PingoGate 鉴权）----
# 每个是独立 principal，可按 name 归因日志/指标
# 客户端用 Authorization: Bearer <key> 或 x-api-key: <key> 鉴权
gateway_keys:
  - { name: "team-alpha", secret_ref: "env:PINGO_KEY_ALPHA", enabled: true }
  - { name: "team-beta",  secret_ref: "env:PINGO_KEY_BETA",  enabled: true }

# ---- 上游 Provider（可配多个，不同平台/不同协议）----
# kind: openai-compatible | anthropic | gemini
# auth.method: bearer | api_key_header | query_key
# auth.key_ref: env:VAR_NAME 或 plain:内联明文（宪法 XX，不推荐生产用 plain:）
# timeout_ms: 可选，per-provider 超时覆盖（覆盖全局 upstream.timeout_ms）
providers:
  # OpenAI 官方 - 用 env 引用密钥
  - name: "openai-official"
    kind: "openai-compatible"
    base_url: "https://api.openai.com"
    auth: { method: "bearer", key_ref: "env:OPENAI_API_KEY" }
    capability_families: ["generation.stateless"]
    timeout_ms: 120000  # OpenAI 偶尔慢，给 2 分钟

  # Anthropic 官方
  - name: "anthropic-official"
    kind: "anthropic"
    base_url: "https://api.anthropic.com"
    anthropic_version: "2023-06-01"
    auth: { method: "api_key_header", key_ref: "env:ANTHROPIC_API_KEY" }
    capability_families: ["generation.stateless"]
    timeout_ms: 180000  # Anthropic 长文本生成更慢

  # Google Gemini 官方
  - name: "gemini-official"
    kind: "gemini"
    base_url: "https://generativelanguage.googleapis.com"
    auth: { method: "query_key", key_ref: "env:GEMINI_API_KEY" }
    capability_families: ["generation.stateless"]
    # 不设 timeout_ms -> 用全局 upstream.timeout_ms

  # 第二个 OpenAI-compatible 平台（自建代理 / Azure OpenAI / 第三方）
  # 用 plain: 内联明文（方便本地开发，生产用 env:）
  - name: "my-proxy"
    kind: "openai-compatible"
    base_url: "https://my-proxy.example.com"
    auth: { method: "bearer", key_ref: "plain:sk-my-proxy-inline-key-xxxxxx" }
    capability_families: ["generation.stateless"]

  # 同一平台但不同协议（issue 1: 一个上游接入不同模型用不同接口模式）
  # 这个平台同时支持 OpenAI Chat 风格和 Anthropic Messages 风格
  # 配两个 provider 指向同一 base_url，不同 kind + auth
  - name: "multi-platform-openai"
    kind: "openai-compatible"
    base_url: "https://multi.example.com"
    auth: { method: "bearer", key_ref: "env:MULTI_PLATFORM_KEY" }
    capability_families: ["generation.stateless"]
  - name: "multi-platform-anthropic"
    kind: "anthropic"
    base_url: "https://multi.example.com"
    anthropic_version: "2023-06-01"
    auth: { method: "api_key_header", key_ref: "env:MULTI_PLATFORM_KEY" }
    capability_families: ["generation.stateless"]

  # 自定义路径上游（issue 2: 上游路径不是 /v1/chat/completions）
  # 这个平台用 /api/v2/models/{model}/generate 而非标准路径
  - name: "custom-path-proxy"
    kind: "openai-compatible"
    base_url: "https://custom.example.com"
    auth: { method: "bearer", key_ref: "env:CUSTOM_PATH_KEY" }
    capability_families: ["generation.stateless"]

# ---- 路由（模型别名 -> provider + 上游模型名）----
# 客户端传 model: "<alias>"，网关路由到对应 provider，注入该 provider 的 key
# upstream_path: 可选，上游路径模板（支持 {model} 占位符），不设 = 透传客户端路径
# auth_method: 可选，per-route auth 覆盖（允许同 provider 不同 route 用不同 auth）
routes:
  # ---- 标准 OpenAI 官方模型 ----
  - { alias: "gpt-4o",       provider: "openai-official", upstream_model: "gpt-4o" }
  - { alias: "gpt-4o-mini",  provider: "openai-official", upstream_model: "gpt-4o-mini" }
  - { alias: "o3-pro",       provider: "openai-official", upstream_model: "o3-pro" }

  # ---- Anthropic 模型 ----
  - { alias: "claude-sonnet", provider: "anthropic-official", upstream_model: "claude-3-5-sonnet-latest" }
  - { alias: "claude-haiku",  provider: "anthropic-official", upstream_model: "claude-3-5-haiku-latest" }

  # ---- Gemini 模型 ----
  - { alias: "gemini-pro",   provider: "gemini-official", upstream_model: "gemini-1.5-pro" }
  - { alias: "gemini-flash", provider: "gemini-official", upstream_model: "gemini-1.5-flash" }

  # ---- 自建平台模型（标准路径透传）----
  - { alias: "custom-gpt",   provider: "my-proxy", upstream_model: "my-custom-model" }

  # ---- 同一平台不同协议（issue 1）----
  # multi-platform 的 gpt 风格模型走 openai-compatible provider
  - { alias: "mp-gpt-4o",    provider: "multi-platform-openai", upstream_model: "gpt-4o" }
  # multi-platform 的 claude 风格模型走 anthropic provider（同一密钥，不同 auth）
  - { alias: "mp-claude",    provider: "multi-platform-anthropic", upstream_model: "claude-3.5-sonnet" }

  # ---- 自定义上游路径（issue 2）----
  # 上游不是 /v1/chat/completions，而是 /api/v2/models/{model}/generate
  # {model} 会被替换为 upstream_model 的值
  - alias: "custom-gen"
    provider: "custom-path-proxy"
    upstream_model: "my-model"
    upstream_path: "/api/v2/models/{model}/generate"

  # ---- 自定义上游路径 + auth 覆盖（issue 1+2 组合）----
  # 上游用 Anthropic 协议但 Bearer auth（某些代理这么干）
  - alias: "weird-proxy"
    provider: "custom-path-proxy"
    upstream_model: "special-model"
    upstream_path: "/anthropic/v1/messages"
    auth_method: "bearer"

# ---- 上游超时（全局默认，per-provider timeout_ms 覆盖此值）----
upstream: { timeout_ms: 60000 }
